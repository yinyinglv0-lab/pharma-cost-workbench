    "labor": "单位人工成本",
    "overhead": "单位制造间接费",
    "unitcost": "单位完全成本",
    "output": "合格完工量",
    "total": "完工总成本"
  },
  "currency": {
    "source_column": "成本币种",
    "target": "CNY",
    "rates": [{"source": "CNY", "factor": "1"}]
