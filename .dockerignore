# Deny everything, then allow only application code and required UI assets.
**
!requirements.txt
!requirements-models.txt
!*.py
!enterprise/
!enterprise/**/
!enterprise/**/*.py
!app_pages/
!app_pages/**/*.py
!dashboard/
!dashboard/**/*.py
!report/
!report/**/*.py
!rag_fixed_v1/
!rag_fixed_v1/**/*.py
!scripts/
!scripts/backup_restore.py
!scripts/preflight.py
!scripts/run_task_worker.py
!assets/
!assets/echarts.min.js
!assets/echarts-LICENSE.txt
!assets/echarts-NOTICE.txt
!assets/licenses/
!assets/licenses/LICENSE-d3
!assets/licenses/LICENSE-zrender
!assets/licenses/LICENSE-tslib
!deploy/
!deploy/entrypoint.py
!deploy/healthcheck.py
!deploy/generate_inventory.py
!deploy/container_smoke.py
!deploy/streamlit.config.toml
!Dockerfile
!.dockerignore

# Defense in depth for additions to the allowlist.
**/.git/**
**/.venv/**
**/__pycache__/**
**/.pytest_cache/**
**/.local/**
**/.streamlit/secrets.toml
**/.env
**/.env.*
**/*secret*
**/*credential*
**/authorization*.json
**/*.db
**/*.db-*
**/*.sqlite*
**/*.csv
**/*.xlsx
**/*.xls
**/*.pdf
**/*.docx
**/*.doc
**/*.key
**/*.pem
**/*.safetensors
**/*.bin
**/*.onnx
**/tests/**
test_*.py
