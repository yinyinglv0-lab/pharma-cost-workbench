# Copy to .env outside source delivery, then provide actual IdP configuration.
# Empty required fields cause compose/preflight to fail. No default identity or password.
COST_IMAGE_TAG=local
COST_WEB_PORT=8501
COST_API_PORT=8000
COST_MEMORY_LIMIT=8g
COST_CPUS=2.0
# Build-time switch: true includes local BGE dependencies; model weights stay external.
# false produces a core-only image and semantic retrieval is unavailable.
INSTALL_LOCAL_MODELS=true
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

COST_OIDC_ISSUER=
COST_OIDC_AUDIENCE=
COST_OIDC_JWKS_URL=
# Required, nonsecret service subject, e.g. your IdP's cost-task-worker subject.
# It must match an enabled users entry in the server authorization JSON, with
# supervisor/task.send and the approved factories/products. No default identity.
COST_WORKER_SUBJECT=
# Absolute host file paths. Both files must be readable by container UID 10001.
COST_AUTHORIZATION_HOST_FILE=
COST_STREAMLIT_SECRETS_HOST_FILE=

# Optional local model mount; only used with deploy/compose.models.yaml.
# Mount root should contain bge-m3/ and bge-reranker-v2-m3/.
COST_MODELS_HOST_DIR=

# Local bare-Python deployment only; production compose fixes OIDC/default tenant.
# COST_AUTH_MODE=local
# COST_BIND_HOST=127.0.0.1
# COST_TENANT_ID=default
# COST_DATA_DIR=/absolute/authorized-business-data
# COST_MANAGED_DIR=/absolute/authorized-managed-data
# COST_AUTHORIZATION_FILE=/absolute/private/authorization.json
# COST_STREAMLIT_SECRETS=/absolute/private/secrets.toml
# COST_LLM_CONFIG_FILE=/absolute/private/llm.json
# COST_MODEL_MANIFEST=/absolute/models/model-manifest.json
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# A dotenv file is read by docker compose; Python CLIs need exported variables.
# Optional selectable analysis providers, server environment only. No real keys here.
# Listing or saving a model selection never grants cloud consent or runs a probe.
# DASHSCOPE_API_KEY=
# DASHSCOPE_APPROVED_CLOUD=false
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_API_KEY=
# DEEPSEEK_APPROVED_CLOUD=false
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-flash
# Per-model timeouts and reviewed registry entries: docs/任务级模型配置.md
